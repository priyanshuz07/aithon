APP_NAME=AI Behavior Firewall 2.0
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///../data/behavior_firewall.db
DATA_RETENTION_ENABLED=true
DATA_RETENTION_DAYS=90
SAFE_DEMO_MODE=true
ADAPTIVE_DELAY_MS=2500
DEMO_CHALLENGE_TTL_SECONDS=300
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","http://localhost:5501","http://127.0.0.1:5501","http://localhost:5173","http://127.0.0.1:5173"]

# Optional: use a trained local artifact. Default: ../data/behavior_model.joblib.
# ML_MODEL_PATH=../data/behavior_model.joblib

# Optional: configure a private administrator key (at least 24 characters).
# ADMIN_API_KEY=
